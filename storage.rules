rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/product-images/{imageId} {
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if false;
    }

    match /organizations/{organizationId}/products/{productId}/{imageId} {
      // Canonical images are written only by the Admin SDK. Clients use the
      // unguessable download token returned by finalizeProductImage.
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
