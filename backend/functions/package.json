{
  "name": "jce-pos-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "access:provision": "node scripts/provision-user-access.js",
    "build": "tsc",
    "db:migrate": "node scripts/apply-schema.js",
    "db:migrate:iam": "node scripts/apply-schema-iam.js",
    "lint": "npm run security:check && tsc --noEmit",
    "security:check": "node scripts/check-no-client-bootstrap.js",
    "test": "npm run build && node --test lib/*.test.js lib/remote_commands/*.test.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@google-cloud/cloud-sql-connector": "^1.11.1",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "google-auth-library": "^10.9.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
